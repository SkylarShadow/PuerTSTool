{
    "name": "metagame",
    "version": "1.0.0",
    "description": "UE5_Puerts",
    "main": "index.js",
    "scripts": {
        "format": "prettier --write \"TypeScript/**/*.ts\"",
        "format:check": "prettier --check \"TypeScript/**/*.ts\"",
        "lint": "eslint TypeScript --fix",
        "lint:check": "eslint TypeScript",
        "type-check": "tsc --noEmit",
        "fix": "npm run lint && npm run format",
        "check": "npm run type-check && npm run lint:check && npm run format:check",
        "check:build": "npm run check && npm run build",
        "watch": "tsc -p tsconfig.json --watch",
        "build": "tsc -p tsconfig.json"
    },
    "author": "Skylar",
    "license": "ISC",
    "devDependencies": {
        "typescript": "^5.5.4",
	    "@types/node": "^20.0.0",

        "eslint": "^9.32.0",
        "@eslint/js": "^9.32.0",
        "typescript-eslint": "^8.39.0",

        "prettier": "^3.6.2",
        "eslint-config-prettier": "^10.1.8",

        "eslint-plugin-import": "^2.32.0",
        "globals": "^16.3.0"
    },
    "dependencies": {
        "source-map": "^0.7.6",
        "source-map-support": "^0.5.21",
        "puerts-editor": "file:./Content/JavaScript/PuertsEditor"
    },
    "private": true
