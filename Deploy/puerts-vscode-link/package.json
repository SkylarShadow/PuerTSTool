{
    "name": "puerts-tool-vscode-link",
    "displayName": "PuerTS Tool Link",
    "description": "PuerTS Blueprint links, declaration previews, and DTS API completion for VSCode.",
    "version": "0.3.2",
    "publisher": "puerts-tool",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onLanguage:typescript",
        "onCommand:puertsTool.openBlueprint",
        "onCommand:puertsTool.revealBlueprint",
        "onCommand:puertsTool.peekTypeDeclaration",
        "onCommand:puertsTool.openTypeDeclaration"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "puertsTool.openBlueprint",
                "title": "PuerTS: Open Blueprint"
            },
            {
                "command": "puertsTool.revealBlueprint",
                "title": "PuerTS: Reveal Blueprint In Content Browser"
            },
            {
                "command": "puertsTool.peekTypeDeclaration",
                "title": "PuerTS: Peek Type Declaration"
            },
            {
                "command": "puertsTool.openTypeDeclaration",
                "title": "PuerTS: Open Type Declaration"
            }
        ],
        "configuration": {
            "title": "PuerTS Tool",
            "properties": {
                "puertsTool.bridgeHost": {
                    "type": "string",
                    "default": "127.0.0.1",
                    "description": "Host of the PuerTSTool editor TCP bridge."
                },
                "puertsTool.bridgePort": {
                    "type": "number",
                    "default": 18777,
                    "description": "Port of the PuerTSTool editor TCP bridge."
                },
                "puertsTool.hoverPreviewMaxLines": {
                    "type": "number",
                    "default": 28,
                    "minimum": 8,
                    "maximum": 120,
                    "description": "Maximum declaration lines shown in PuerTS hover previews before using Peek Declaration."
                }
            }
        }
    },
    "scripts": {
        "typecheck": "tsc -p . --noEmit",
        "compile": "npm run typecheck && esbuild ./src/extension.ts --bundle --platform=node --target=node20 --format=cjs --external:vscode --outfile=dist/extension.js",
        "watch": "esbuild ./src/extension.ts --bundle --platform=node --target=node20 --format=cjs --external:vscode --outfile=dist/extension.js --watch"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/vscode": "^1.90.0",
        "typescript": "^5.5.4",
        "esbuild": "^0.27.2",
        "flexsearch": "^0.8.212"
    }
}
